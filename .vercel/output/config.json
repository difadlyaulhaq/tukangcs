{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/_actions(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/signout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/dashboard-data/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/delete/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/list/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/stats/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/text/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/upload/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/knowledge-base/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/test-env/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/whatsapp/connect/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/whatsapp/connect copy/?$",
			"dest": "_render"
