---
import Navbar from '../components/navbar/navbar.astro';
import Footer from '../components/footer/footer.astro';
import LoginStyle from '../components/styles/LoginStyle.astro';
import { actions } from 'astro:actions';

const result = Astro.getActionResult(actions.login);

// Check if user is already logged in via session cookie
const sessionCookie = Astro.cookies.get('session');
if (sessionCookie?.value) {
  try {
    // Verify session with Firebase Admin
    const { adminAuth } = await import('../lib/firebase-admin');
    if (adminAuth) {
      await adminAuth.verifySessionCookie(sessionCookie.value);
      // If verification succeeds, redirect to dashboard
      return Astro.redirect('/dashboard');
    }
  } catch (error) {
    // Session invalid, clear cookie
    Astro.cookies.delete('session');
  }
}

// Redirect if login successful
if (result && !result.error) {
  return Astro.redirect('/dashboard');
}
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - TukangCS</title>
    <LoginStyle />
  </head>
  <body>
    <Navbar />

    <div class="container">
      <h1>Login</h1>
      <form method="POST" action={actions.login}>
        <div id="message">
          {result?.error && (
            <div class="message error">{result.error.message}</div>
          )}
          {result && !result.error && (
            <div class="message success">Login berhasil!</div>
          )}
        </div>
        <input 
          type="email" 
          name="email" 
          placeholder="Gmail" 
          required 
          value={result?.error ? (Astro.url.searchParams.get('email') || '') : ''}
        />
        <input type="password" name="password" placeholder="Password" required />
        <button type="submit">Masuk</button>
      </form>
      <p class="note">Belum punya akun? <a href="/register">Daftar di sini</a></p>
    </div>

    <Footer />
  </body>
</html>
