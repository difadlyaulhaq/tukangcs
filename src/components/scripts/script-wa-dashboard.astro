<script>
// WhatsApp Connection Logic menggunakan action dari connect.ts
document.addEventListener("DOMContentLoaded", () => {
  const waPlatform = document.getElementById("wa-platform");
  const waStatus = document.getElementById("wa-status");
  const waPhone = document.getElementById("wa-phone");
  const waPairingBtn = document.getElementById("wa-pairing-btn");
  const waQrBtn = document.getElementById("wa-qr-btn");
  const waPhoneModal = document.getElementById("wa-phone-modal");
  const waPhoneInput = document.getElementById("wa-phone-input");
  const waPhoneCancel = document.getElementById("wa-phone-cancel");
  const waPhoneGenerate = document.getElementById("wa-phone-generate");
  const waPairingModal = document.getElementById("wa-pairing-modal");
  const waPairingPhone = document.getElementById("wa-pairing-phone");
  const waPairingCode = document.getElementById("wa-pairing-code");
  const waPairingClose = document.getElementById("wa-pairing-close");
  const waQrModal = document.getElementById("wa-qr-modal");
  const waQrImg = document.getElementById("wa-qr-img");
  const waQrClose = document.getElementById("wa-qr-close");

  // Event Handlers
  if (waPairingBtn) {
    waPairingBtn.addEventListener('click', () => {
      if (waPhoneModal) waPhoneModal.style.display = 'flex';
    });
  }

  if (waQrBtn) {
    waQrBtn.addEventListener('click', () => {
      connectWithQR();
    });
  }

  if (waPhoneCancel) {
    waPhoneCancel.addEventListener('click', () => {
      if (waPhoneModal) waPhoneModal.style.display = 'none';
      const phoneInput = waPhoneInput as HTMLInputElement;
      if (phoneInput) phoneInput.value = '';
    });
  }

  if (waPhoneGenerate) {
    waPhoneGenerate.addEventListener('click', () => {
      generatePairingCode();
    });
  }

  if (waPairingClose) {
    waPairingClose.addEventListener('click', () => {
      if (waPairingModal) waPairingModal.style.display = 'none';
    });
  }

  if (waQrClose) {
    waQrClose.addEventListener('click', () => {
      if (waQrModal) waQrModal.style.display = 'none';
    });
  }

  // Generate Pairing Code Function
  async function generatePairingCode() {
    const phoneInput = waPhoneInput as HTMLInputElement;
    const phoneNumber = phoneInput?.value?.trim() || '';

    if (!phoneNumber) {
      showNotification('Nomor telepon harus diisi', 'error');
      return;
    }

    try {
      // Hide phone modal and show loading
      if (waPhoneModal) waPhoneModal.style.display = 'none';
      if (waStatus) waStatus.textContent = 'Menghubungkan...';

      // Create form data for connect.ts action
      const formData = new FormData();
      formData.append('phoneNumber', phoneNumber);

      const response = await fetch('/api/whatsapp/connect', {
        method: 'POST',
        body: formData
      });

      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }

      const result = await response.json();

      if (result.res && result.res.pairing_code) {
        // Show pairing code modal
        if (waPairingPhone) waPairingPhone.textContent = phoneNumber;
        if (waPairingCode) waPairingCode.textContent = result.res.pairing_code;
        if (waPairingModal) waPairingModal.style.display = 'flex';

        showNotification('Kode pairing berhasil dibuat!', 'success');
        
        // Update status
        if (waStatus) waStatus.textContent = 'Menunggu konfirmasi...';
        
        // Start polling for connection status
        startConnectionPolling();
      } else {
        throw new Error(result.res?.message || 'Gagal mendapatkan pairing code');
      }
    } catch (error: any) {
      console.error('Pairing code error:', error);
      showNotification('Gagal membuat kode pairing: ' + (error?.message || 'Unknown error'), 'error');
      if (waStatus) waStatus.textContent = 'Terputus';
    }
  }

  // Connect with QR Code (placeholder for now)
  async function connectWithQR() {
    showNotification('Fitur QR Code sedang dalam pengembangan', 'info');
  }

  // Polling for connection status
  function startConnectionPolling() {
    let attempts = 0;
    const maxAttempts = 30; // 30 x 2 seconds = 1 minute

    const pollInterval = setInterval(async () => {
      attempts++;
      
      try {
        // Check connection status
        const response = await fetch('/api/whatsapp/status', {
          method: 'GET'
        });

        if (response.ok) {
          const data = await response.json();
          
          // Update status based on the response
          updateConnectionStatus(data);
          
          // If fully connected, stop polling
          if (data.connected && (data.status === 'connected' || data.status === 'open')) {
            clearInterval(pollInterval);
            
            // Hide modals and connection buttons
            if (waPairingModal) waPairingModal.style.display = 'none';
            const connectionMethods = document.getElementById('wa-connection-methods');
            if (connectionMethods) connectionMethods.style.display = 'none';

            showNotification('WhatsApp berhasil terhubung!', 'success');
          }
        }
      } catch (error) {
        console.error('Polling error:', error);
      }

      // Stop polling after max attempts
      if (attempts >= maxAttempts) {
        clearInterval(pollInterval);
        if (waStatus) waStatus.textContent = 'Timeout - silakan coba lagi';
        showNotification('Timeout - silakan coba menghubungkan lagi', 'warning');
      }
    }, 2000);
  }

  // Update connection status based on API response
  function updateConnectionStatus(data: any) {
    const { connected, status, phoneNumber } = data;
    
    if (waPlatform) {
      waPlatform.classList.remove('connected', 'connecting', 'disconnected');
      
      if (connected && (status === 'connected' || status === 'open')) {
        waPlatform.classList.add('connected');
      } else if (status === 'connecting') {
        waPlatform.classList.add('connecting');
      } else {
        waPlatform.classList.add('disconnected');
      }
    }
    
    if (waStatus) {
      let statusText = '';
      let statusClass = '';
      
      switch (status) {
        case 'connected':
        case 'open':
          statusText = 'Terhubung';
          statusClass = 'status-badge status-connected';
          break;
        case 'connecting':
          statusText = 'Menghubungkan...';
          statusClass = 'status-badge status-connecting';
          break;
        case 'close':
          statusText = 'Terputus';
          statusClass = 'status-badge status-disconnected';
          break;
        default:
          statusText = 'Tidak terhubung';
          statusClass = 'status-badge status-disconnected';
      }
      
      waStatus.textContent = statusText;
      waStatus.className = statusClass;
    }
    
    if (waPhone) {
      waPhone.textContent = phoneNumber || (connected ? 'Terhubung' : 'Tidak terhubung');
    }
  }

  // Show notification function
  function showNotification(message: string, type: string = 'info') {
    const notification = document.getElementById('notification');
    if (notification) {
      notification.innerHTML = `
        <i class="fas ${type === 'success' ? 'fa-check-circle' : 
                      type === 'error' ? 'fa-exclamation-circle' : 
                      type === 'warning' ? 'fa-exclamation-triangle' : 
                      'fa-info-circle'}"></i>
        <span>${message}</span>
      `;
      notification.style.display = 'flex';
      notification.classList.add('show');
      
      // Auto hide after 5 seconds
      setTimeout(() => {
        notification.classList.remove('show');
        setTimeout(() => {
          notification.style.display = 'none';
        }, 300);
      }, 5000);
    }
  }

  // Initialize - check current status
  async function checkInitialStatus() {
    try {
      const response = await fetch('/api/whatsapp/status', {
        method: 'GET'
      });
      
      if (response.ok) {
        const data = await response.json();
        updateConnectionStatus(data);
        
        // If already connected, hide connection methods
        if (data.connected && (data.status === 'connected' || data.status === 'open')) {
          const connectionMethods = document.getElementById('wa-connection-methods');
          if (connectionMethods) connectionMethods.style.display = 'none';
        }
      }
    } catch (error) {
      console.error('Initial status check error:', error);
    }
  }

  // Call initial status check
  checkInitialStatus();
});
</script>