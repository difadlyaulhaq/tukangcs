---
// src/components/KnowledgeBase.astro
---

<div id="knowledge-base" class="content-section">
  <div class="card">
    <h2 class="card-title">
      <i class="fas fa-database"></i> Knowledge Base
    </h2>
    <p>
      Kelola data pengetahuan untuk melatih chatbot AI Anda. Siapa saja dapat menambahkan data, namun Anda harus login untuk melihat dan mengelola data yang telah Anda simpan.
    </p>

    <div id="userInfoSection" class="user-info-section" style="display: none;">
      <div class="user-info-content">
        <div class="user-info-item">
          <span class="user-info-label"><i class="fas fa-envelope"></i> Email:</span>
          <span id="userEmail" class="user-info-value">-</span>
        </div>
        <div class="user-info-item">
          <span class="user-info-label"><i class="fas fa-store"></i> UMKM:</span>
          <span id="userUmkmName" class="user-info-value">-</span>
        </div>
      </div>
    </div>

    <div id="addKnowledgeForm">
      <div class="form-group">
        <label class="form-label">Judul Knowledge</label>
        <input
          type="text"
          id="knowledgeTitle"
          class="form-input"
          placeholder="Masukkan judul knowledge (minimal 3 karakter)"
          maxlength="200"
        />
      </div>

      <div class="form-group">
        <label class="form-label">Konten Knowledge</label>
        <textarea
          id="knowledgeContent"
          class="form-textarea"
          placeholder="Masukkan informasi tentang produk, layanan, FAQ, atau data perusahaan lainnya... (minimal 200 karakter)"
          rows="8"
        ></textarea>
        <div class="character-counter">
          <span id="charCount">0</span> karakter (minimal 200)
        </div>
      </div>

      <div class="form-actions">
      <button id="saveKnowledgeBtn" class="btn btn-primary" disabled>
           <i class="fas fa-spinner fa-spin"></i> Memuat...
        </button>
        <button id="clearFormBtn" class="btn btn-secondary">
          <i class="fas fa-eraser"></i> Bersihkan Form
        </button>
      </div>
    </div>

    <div id="savedKnowledgeSection" style="display: none;">
      <div class="knowledge-header">
        <h3>
          <i class="fas fa-list"></i> Data Knowledge Tersimpan Anda
        </h3>
        <div class="knowledge-stats">
          <span id="totalCount">0</span> data knowledge
        </div>
      </div>

      <div class="search-section">
        <div class="search-input-container">
          <input
            type="text"
            id="searchInput"
            class="search-input"
            placeholder="Cari knowledge berdasarkan judul atau konten..."
          />
          <i class="fas fa-search search-icon"></i>
        </div>
      </div>

      <div id="loadingState" class="loading-state" style="display: none;">
        <i class="fas fa-spinner fa-spin"></i>
        <span>Memuat data knowledge...</span>
      </div>

      <div id="knowledge-container">
        </div>

      <div id="pagination" class="pagination-container" style="display: none;">
        <button id="prevBtn" class="btn btn-outline">
          <i class="fas fa-chevron-left"></i> Sebelumnya
        </button>
        <div id="pageInfo" class="page-info">
          Halaman <span id="currentPage">1</span> dari <span id="totalPages">1</span>
        </div>
        <button id="nextBtn" class="btn btn-outline">
          Selanjutnya <i class="fas fa-chevron-right"></i>
        </button>
      </div>
    </div>
     <div id="loginPrompt" class="empty-state" style="display: none;">
        <div class="empty-content">
            <i class="fas fa-sign-in-alt"></i>
            <h4>Login untuk Melihat Data</h4>
            <p>Silakan login untuk melihat dan mengelola data knowledge Anda.</p>
        </div>
    </div>
  </div>
</div>

<div id="notification" class="notification"></div>
<div id="deleteModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h4><i class="fas fa-trash"></i> Konfirmasi Hapus</h4>
      <button id="closeModal" class="close-btn">&times;</button>
    </div>
    <div class="modal-body">
      <p>Apakah Anda yakin ingin menghapus knowledge ini?</p>
      <div class="knowledge-preview">
        <strong id="deleteTitle"></strong>
        <p id="deletePreview"></p>
      </div>
    </div>
    <div class="modal-actions">
      <button id="confirmDelete" class="btn btn-danger"><i class="fas fa-trash"></i> Hapus</button>
      <button id="cancelDelete" class="btn btn-secondary"><i class="fas fa-times"></i> Batal</button>
    </div>
  </div>
</div>

<script>
  import { onAuthStateChange } from '../../lib/auth-helper';
  import type { User } from 'firebase/auth';

  // --- INTERFACES ---
  interface KnowledgeData {
    id: string;
    title: string;
    content: string;
    userId: string | null;
    email?: string | null;
    nama_umkm?: string | null;
    createdAt: any;
    updatedAt: any;
  }

  interface ApiResponse<T> {
    success: boolean;
    error?: string;
    data?: T;
    pagination?: {
      currentPage: number;
      totalPages: number;
      totalDocuments: number;
      hasNextPage: boolean;
      hasPrevPage: boolean;
    };
  }

  type NotificationType = 'success' | 'error' | 'warning' | 'info';

  declare global {
    interface Window {
      deleteKnowledge: (id: string, title: string, content: string) => void;
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    // --- DOM ELEMENTS ---
    const titleInput = document.getElementById('knowledgeTitle') as HTMLInputElement;
    const contentTextarea = document.getElementById('knowledgeContent') as HTMLTextAreaElement;
    const saveBtn = document.getElementById('saveKnowledgeBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearFormBtn') as HTMLButtonElement;
    const charCount = document.getElementById('charCount') as HTMLElement;
    const userInfoSection = document.getElementById('userInfoSection') as HTMLElement;
    const userEmailSpan = document.getElementById('userEmail') as HTMLElement;
    const userUmkmSpan = document.getElementById('userUmkmName') as HTMLElement;
    const savedKnowledgeSection = document.getElementById('savedKnowledgeSection') as HTMLElement;
    const searchInput = document.getElementById('searchInput') as HTMLInputElement;
    const knowledgeContainer = document.getElementById('knowledge-container') as HTMLElement;
    const loadingState = document.getElementById('loadingState') as HTMLElement;
    const totalCount = document.getElementById('totalCount') as HTMLElement;
    const loginPrompt = document.getElementById('loginPrompt') as HTMLElement;
    const pagination = document.getElementById('pagination') as HTMLElement;
    const prevBtn = document.getElementById('prevBtn') as HTMLButtonElement;
    const nextBtn = document.getElementById('nextBtn') as HTMLButtonElement;
    const currentPageSpan = document.getElementById('currentPage') as HTMLElement;
    const totalPagesSpan = document.getElementById('totalPages') as HTMLElement;
    const deleteModal = document.getElementById('deleteModal') as HTMLElement;
    const closeModal = document.getElementById('closeModal') as HTMLButtonElement;
    const confirmDelete = document.getElementById('confirmDelete') as HTMLButtonElement;
    const cancelDelete = document.getElementById('cancelDelete') as HTMLButtonElement;
    const deleteTitle = document.getElementById('deleteTitle') as HTMLElement;
    const deletePreview = document.getElementById('deletePreview') as HTMLElement;

    // --- STATE ---
    let currentPage = 1;
    let totalPages = 1;
    let searchTerm = '';
    let pendingDeleteId = '';
    let currentUserId: string | null = null;
    let currentUserEmail: string | null = null;
    let currentUserUmkmName: string | null = null;
    let isUserAuthenticated = false;

    // --- INITIALIZATION ---
    setupEventListeners();
    onAuthStateChange(handleAuthStateChange);

    // --- AUTHENTICATION & UI LOGIC ---
    async function handleAuthStateChange(user: User | null) {
      if (user) {
        // User is logged in
        isUserAuthenticated = true;
        currentUserId = user.uid;
        
        loginPrompt.style.display = 'none';
        savedKnowledgeSection.style.display = 'block';
        
        try {
          showNotification('Autentikasi berhasil, memuat data Anda...', 'info');
          await fetchDashboardData();
          await loadKnowledgeData();
        } catch (error) {
            console.error("Initialization error for logged in user:", error);
            showNotification('Gagal memuat semua data pengguna.', 'error');
        } finally {
            // **PERBAIKAN UTAMA**: Tombol diaktifkan setelah semua data coba dimuat
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-save"></i> Simpan Knowledge';
        }

      } else {
        // User is logged out or anonymous
        isUserAuthenticated = false;
        currentUserId = null;
        currentUserEmail = null;
        currentUserUmkmName = null;
        
        userInfoSection.style.display = 'none';
        savedKnowledgeSection.style.display = 'none';
        loginPrompt.style.display = 'block';

        // **PERBAIKAN UTAMA**: Aktifkan tombol untuk pengguna anonim
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-save"></i> Simpan Knowledge';
      }
    }

    async function fetchDashboardData(): Promise<void> {
      if (!isUserAuthenticated) return;
      try {
        const response = await fetch('/api/dashboard-data');
        if (!response.ok) throw new Error('Gagal mengambil data dashboard');
        
        const result = await response.json();
        if (result.user) {
          currentUserEmail = result.user.email;
          currentUserUmkmName = result.user.nama_umkm;
          updateUserInfoUI();
        }
      } catch (error) {
        console.error('Error fetching dashboard data:', error);
        showNotification('Gagal memuat informasi profil Anda.', 'error');
        // Re-throw agar bisa ditangkap oleh block `catch` di `handleAuthStateChange` jika diperlukan
        throw error;
      }
    }

    function updateUserInfoUI(): void {
      if (currentUserEmail) {
        userEmailSpan.textContent = currentUserEmail;
        userUmkmSpan.textContent = currentUserUmkmName || 'Tidak ada';
        userInfoSection.style.display = 'block';
      } else {
        userInfoSection.style.display = 'none';
      }
    }

    // --- EVENT LISTENERS ---
    function setupEventListeners(): void {
      contentTextarea.addEventListener('input', updateCharCounter);
      saveBtn.addEventListener('click', handleSaveKnowledge);
      clearBtn.addEventListener('click', clearForm);
      
      let searchTimeout: NodeJS.Timeout;
      searchInput.addEventListener('input', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          searchTerm = searchInput.value.trim();
          currentPage = 1;
          loadKnowledgeData();
        }, 500);
      });
      
      prevBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; loadKnowledgeData(); } });
      nextBtn.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; loadKnowledgeData(); } });
      
      closeModal.addEventListener('click', closeDeleteModal);
      cancelDelete.addEventListener('click', closeDeleteModal);
      confirmDelete.addEventListener('click', handleConfirmDelete);
      
      window.addEventListener('click', (e) => { if (e.target === deleteModal) closeDeleteModal(); });
    }

    // --- CORE FUNCTIONS ---
    function updateCharCounter(): void {
      const count = contentTextarea.value.length;
      charCount.textContent = count.toString();
      charCount.style.color = count < 200 ? '#dc3545' : '#28a745';
    }

    async function handleSaveKnowledge(): Promise<void> {
      const title = titleInput.value.trim();
      const content = contentTextarea.value.trim();
      
      if (title.length < 3) {
        showNotification('Judul minimal 3 karakter', 'warning');
        return titleInput.focus();
      }
      if (content.length < 200) {
        showNotification('Konten minimal 200 karakter', 'warning');
        return contentTextarea.focus();
      }

      const payload = { title, content, userId: currentUserId, email: currentUserEmail, nama_umkm: currentUserUmkmName };

      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menyimpan...';

      try {
        const response = await fetch('/api/knowledge-base/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result: ApiResponse<KnowledgeData> = await response.json();

        if (result.success) {
          showNotification('Knowledge berhasil disimpan!', 'success');
          clearForm();
          if (isUserAuthenticated) {
            loadKnowledgeData();
          }
        } else {
          throw new Error(result.error || 'Gagal menyimpan knowledge');
        }
      } catch (error) {
        console.error('Save knowledge error:', error);
        const errorMsg = error instanceof Error ? error.message : String(error);
        showNotification(`Gagal menyimpan: ${errorMsg}`, 'error');
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-save"></i> Simpan Knowledge';
      }
    }

    function clearForm(): void {
      titleInput.value = '';
      contentTextarea.value = '';
      updateCharCounter();
      titleInput.focus();
    }

    async function loadKnowledgeData(): Promise<void> {
      if (!isUserAuthenticated || !currentUserId) return;
      showLoading(true);
      try {
        const params = new URLSearchParams({ page: currentPage.toString(), limit: '10', userId: currentUserId, search: searchTerm });
        const response = await fetch(`/api/knowledge/list?${params}`);
        const result = await response.json();
        if (result.success && result.data) {
          displayKnowledgeData(result.data);
          updatePagination(result.pagination);
          updateStats(result.pagination?.totalDocuments || 0);
        } else {
          throw new Error(result.error || 'Gagal memuat data');
        }
      } catch (error) {
        console.error('Load knowledge error:', error);
        showNotification('Gagal memuat data knowledge', 'error');
        displayKnowledgeData([]);
      } finally {
        showLoading(false);
      }
    }

    // --- UI & DISPLAY FUNCTIONS ---
    function displayKnowledgeData(data: KnowledgeData[]): void {
      knowledgeContainer.innerHTML = '';
      if (data.length === 0) {
        const message = searchTerm ? 'Tidak ada knowledge yang cocok dengan pencarian Anda.' : 'Anda belum memiliki data. Mulai tambahkan knowledge pertama Anda!';
        knowledgeContainer.innerHTML = `<div class="empty-state"><p>${message}</p></div>`;
        return;
      }
      data.forEach(item => knowledgeContainer.appendChild(createKnowledgeItem(item)));
    }

    function createKnowledgeItem(item: KnowledgeData): HTMLElement {
      const el = document.createElement('div');
      el.className = 'knowledge-item';
      el.setAttribute('data-id', item.id);
      const preview = item.content.length > 150 ? item.content.substring(0, 150) + '...' : item.content;
      
      el.innerHTML = `
        <div class="knowledge-content">
          <h4 class="knowledge-title">${escapeHtml(item.title)}</h4>
          <p class="knowledge-preview">${escapeHtml(preview)}</p>
          <div class="knowledge-meta">
            <span class="knowledge-date"><i class="fas fa-calendar"></i> ${formatDate(item.createdAt)}</span>
            <span class="knowledge-chars"><i class="fas fa-font"></i> ${item.content.length} karakter</span>
          </div>
        </div>
        <div class="knowledge-actions">
          <button class="btn btn-sm btn-danger" onclick="window.deleteKnowledge('${item.id}', '${escapeHtml(item.title)}', '${escapeHtml(item.content)}')">
            <i class="fas fa-trash"></i>
          </button>
        </div>`;
      return el;
    }

    window.deleteKnowledge = function(id: string, title: string, content: string): void {
      if (!isUserAuthenticated) {
        showNotification('Anda harus login untuk menghapus data', 'error');
        return;
      }
      pendingDeleteId = id;
      deleteTitle.textContent = title;
      deletePreview.textContent = content.substring(0, 100) + (content.length > 100 ? '...' : '');
      deleteModal.style.display = 'flex';
    };

    async function handleConfirmDelete(): Promise<void> {
      if (!pendingDeleteId || !isUserAuthenticated || !currentUserId) return;
      confirmDelete.disabled = true;
      confirmDelete.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Menghapus...';
      try {
        const response = await fetch('/api/knowledge/delete', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: pendingDeleteId, userId: currentUserId })
        });
        const result = await response.json();
        if (result.success) {
          showNotification('Knowledge berhasil dihapus', 'success');
          closeDeleteModal();
          loadKnowledgeData();
        } else {
          throw new Error(result.error || 'Gagal menghapus');
        }
      } catch (error) {
        console.error('Delete error:', error);
        const errorMsg = error instanceof Error ? error.message : String(error);
        showNotification(`Gagal menghapus: ${errorMsg}`, 'error');
      } finally {
        confirmDelete.disabled = false;
        confirmDelete.innerHTML = '<i class="fas fa-trash"></i> Hapus';
      }
    }

    function closeDeleteModal(): void {
      deleteModal.style.display = 'none';
      pendingDeleteId = '';
    }

    // --- HELPER & UTILITY FUNCTIONS ---
    function updatePagination(p: any): void {
      if (!p || p.totalPages <= 1) {
        pagination.style.display = 'none';
        return;
      }
      pagination.style.display = 'flex';
      currentPage = p.currentPage;
      totalPages = p.totalPages;
      currentPageSpan.textContent = p.currentPage.toString();
      totalPagesSpan.textContent = p.totalPages.toString();
      prevBtn.disabled = !p.hasPrevPage;
      nextBtn.disabled = !p.hasNextPage;
    }

    function updateStats(total: number): void {
      totalCount.textContent = total.toString();
    }

    function showLoading(show: boolean): void {
      loadingState.style.display = show ? 'flex' : 'none';
    }

    function formatDate(dateInput: any): string {
      if (!dateInput) return 'Tidak diketahui';
      const date = dateInput.seconds ? new Date(dateInput.seconds * 1000) : new Date(dateInput);
      return date.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function showNotification(message: string, type: NotificationType = 'info'): void {
      const notification = document.getElementById('notification');
      if (!notification) return;
      const iconMap: Record<NotificationType, string> = {
        success: 'fa-check-circle', error: 'fa-exclamation-circle',
        warning: 'fa-exclamation-triangle', info: 'fa-info-circle'
      };
      notification.innerHTML = `<div class="notification-content"><i class="fas ${iconMap[type]}"></i><span>${message}</span></div>`;
      notification.className = `notification ${type} show`;
      setTimeout(() => notification.classList.remove('show'), 5000);
    }
  });
</script>

<style>
